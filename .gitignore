# Nothing derived from the game's own files belongs in this repository.
/input/
/meta/
/src/recomp/
/src/gen/
/src/spu/
/src/recomp.*/
# The emulated HDD (saves, game data) the runs write.
/gamedata/
/gamedata2/
/data/keys
# Local build output.
/build/
/release/
__pycache__/
recomp_spu_ls.bin
scratch/

# Launcher artwork and music (not ours to publish) and installed mods.
/launcher/assets/
/mods/

# Frame captures (F12 / run.ps1 -CaptureAt): frames of the game itself.
/captures/

# Local build settings (scripts read them; never committed).
/.env
/.env.*
